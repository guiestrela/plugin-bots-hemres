{
  "schemaVersion": 1,
  "id": "io.github.guiestrela.hermes-bots",
  "name": "Hermes Bots",
  "version": "0.1.0",
  "author": "Guiestrela",
  "license": "MIT",
  "description": "Hermes bot roster with explicit loopback gateway configuration and user-triggered delegation.",
  "kinds": [
  "bar-widget"
  ],
  "entryPoints": {
  "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Hermes Bots",
    "description": "Panel-only Hermes bot access; RPC runtime support is not verified.",
    "category": "AI",
    "aliases": [
      "hermes-bots",
      "bots-hermes"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "schema": [
      {
        "key": "gatewayUrl",
        "type": "string",
        "label": "Loopback gateway URL (ws://127.0.0.1:<port>/api/ws)",
        "defaultValue": ""
      }
    ]
  }
}